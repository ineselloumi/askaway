{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AskAway Dev",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "node_modules/.bin/next",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "AskAway Dev (mock)",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "GUIDED_MOCK=1",
        "/opt/homebrew/bin/node",
        "node_modules/.bin/next",
        "dev",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "AskAway ChatGPT Dev",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "NEXT_PUBLIC_BRAND=chatgpt",
        "/opt/homebrew/bin/node",
        "node_modules/.bin/next",
        "dev",
        "--port",
        "3003"
      ],
      "port": 3003
    },
    {
      "name": "AskAway ChatGPT Dev (mock)",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "NEXT_PUBLIC_BRAND=chatgpt",
        "GUIDED_MOCK=1",
        "/opt/homebrew/bin/node",
        "node_modules/.bin/next",
        "dev",
        "--port",
        "3004"
      ],
      "port": 3004
    }
  ]
}
