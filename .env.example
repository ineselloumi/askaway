# ── Which site this is ───────────────────────────────────────────────────────
# One codebase, two deployments (see lib/brand.ts):
#   claude   claude.askaway.guide   Anthropic's Claude models, orange accent (default)
#   chatgpt  chatgpt.askaway.guide  OpenAI's GPT models, teal accent
# Read at build time: change it and redeploy.
# NEXT_PUBLIC_BRAND=claude

# ── Model provider ───────────────────────────────────────────────────────────
# Only the key for this site's brand is used. Without it the app still runs and
# returns sample answers, so it demos out of the box.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=
# Optional: use these names instead if the plain ones are already set in your shell.
# ASK_AWAY_ANTHROPIC_KEY=
# ASK_AWAY_OPENAI_KEY=

# ── Guided flow ──────────────────────────────────────────────────────────────
# The guided first-prompt experience is on by default. Set to "off" and redeploy
# to roll back to the original Ask Away home page and /assist flow.
# NEXT_PUBLIC_GUIDED_FLOW=off

# Conversation answers are routed per request: a fast model describes the
# request and rules pick the model (see lib/guided/routing.ts).
# Optional model overrides (defaults shown as claude / chatgpt).
# GUIDED_CHAT_MODEL=claude-haiku-5-5      # gpt-6-luna   quick, everyday asks
# GUIDED_STRONG_MODEL=claude-sonnet-5-5   # gpt-6.1-sol  reasoning, structured work, sensitive topics
# GUIDED_DEEP_MODEL=claude-opus-5-5       # gpt-6-astra  deep reasoning on something that matters
# GUIDED_OPUS_DAILY_CAP=40                # answers per day on the deep model (0 turns it off)
# GUIDED_VISION_MODEL=claude-sonnet-5-5   # gpt-6.1-sol  messages with photos
# GUIDED_AGENT_MODEL=claude-sonnet-5-5    # gpt-6.1-sol  "Do things for me" jobs (web research)

# Jev (TypeSafe AI) does two jobs: it scores the prompt at every pause in typing
# (readiness), and it describes each sent request so a model can be
# picked for it (routing). Without this key, readiness falls back to the chat
# model and then to counting answers, and routing falls back to a fixed rule.
# TYPESAFE_API_KEY=

# Force sample answers even when a key is set (handy for UI work).
# GUIDED_MOCK=1

# ── Accounts and saved history (optional) ────────────────────────────────────
# Visitors get an anonymous session so their history is kept. Without these
# the app runs with no saved conversations.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Original Ask Away flow only (used when NEXT_PUBLIC_GUIDED_FLOW=off) ──────
# PROVIDER=anthropic            # or "openai"
# OPENAI_API_KEY=
# TAVILY_API_KEY=               # web citations
